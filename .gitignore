# Runtime ledger state — the demo/tests write hash-chained ledgers to the OS
# tmpdir (pfc-ledger-*), never into the repo; these patterns are defensive in
# case a future caller points FileLedger at a repo-relative path.
ledger.jsonl
*.ledger.jsonl
pfc-ledger-*/

# NOTE: results.md is deliberately COMMITTED — it is a deliverable
# (scenario outcomes, latency measurements, error-code coverage table),
# regenerated by `node src/demo.ts`.

# Build output — regenerated by `npm run build` (runs automatically via
# the `prepare` script on `npm install <git-url>`).
dist/

# Tooling / OS noise
node_modules/
.DS_Store
*.log
